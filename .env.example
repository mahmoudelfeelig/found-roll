# Found Roll application service: safe connected local defaults
FOUND_ROLL_ENV=development
FOUND_ROLL_REPOSITORY=memory
FOUND_ROLL_EVIDENCE_STORE=memory
FOUND_ROLL_ANALYST_MODE=fixture
FOUND_ROLL_INVENTORY_MODE=http
FOUND_ROLL_INVENTORY_BASE_URL=http://127.0.0.1:8091
FOUND_ROLL_INVENTORY_TIMEOUT_SECONDS=3.0
FOUND_ROLL_INVENTORY_ALLOW_LEGACY_HEALTH_WITHOUT_ENVIRONMENT=false
FOUND_ROLL_RELAY_MODE=http
FOUND_ROLL_TASKS_MODE=inline
FOUND_ROLL_MODEL=gemini-3.5-flash
FOUND_ROLL_DEMO_MODE=true
FOUND_ROLL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FOUND_ROLL_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Replace every local-only value before any production deployment
FOUND_ROLL_SECRET_PEPPER=replace-with-a-long-local-development-secret
FOUND_ROLL_DEMO_ACCESS_TOKEN=replace-with-an-operator-supplied-demo-access-token
FOUND_ROLL_ADMIN_TOKEN=replace-with-a-separate-admin-recovery-token
FOUND_ROLL_EVIDENCE_STAFF_TOKEN=replace-with-an-independent-staff-development-secret
FOUND_ROLL_SUPERVISOR_TOKEN=replace-with-an-independent-supervisor-approval-secret
FOUND_ROLL_STAFF_ACTOR_ID=staff.northport
FOUND_ROLL_SUPERVISOR_ACTOR_ID=supervisor.northport
FOUND_ROLL_RELAY_BASE_URL=http://127.0.0.1:8091
FOUND_ROLL_RELAY_API_KEY=replace-with-the-simulator-api-key
FOUND_ROLL_RELAY_SHARED_SECRET=replace-with-the-simulator-callback-secret
FOUND_ROLL_RELAY_CUSTODIAN_ID=northport-air
FOUND_ROLL_RELAY_DESTINATION=Relay Post secure counter
FOUND_ROLL_RELAY_CALLBACK_MAX_AGE_SECONDS=300

# Current Google ADK / Vertex configuration for canonical live mode
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=replace-with-your-project-id
GOOGLE_CLOUD_LOCATION=global

# Google Cloud resource names for canonical deployed mode
FOUND_ROLL_FIRESTORE_NAMESPACE=foundRoll-submission-v1
FOUND_ROLL_EVIDENCE_BUCKET=replace-with-private-bucket-name
FOUND_ROLL_EVIDENCE_MAX_UPLOAD_BYTES=8388608
FOUND_ROLL_EVIDENCE_PREVIEW_MAX_EDGE=1600
FOUND_ROLL_CLAIM_LINK_TTL_SECONDS=1200
FOUND_ROLL_TASK_LOCATION=us-central1
FOUND_ROLL_TASK_QUEUE=found-roll
FOUND_ROLL_TASK_SERVICE_ACCOUNT=replace-with-task-service-account-email
FOUND_ROLL_REQUIRE_TASK_HEADER=false
FOUND_ROLL_REQUIRE_TASK_OIDC=false

# Separately deployed, permanently disclosed simulator
SIMULATOR_ENV=development
SIMULATOR_API_KEY=replace-with-the-same-simulator-api-key
SIMULATOR_TOKEN_SECRET=replace-with-an-independent-token-secret
SIMULATOR_CALLBACK_SECRET=replace-with-the-same-simulator-callback-secret
